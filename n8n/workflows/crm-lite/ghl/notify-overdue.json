{
  "name": "CRM Lite — Notify Overdue (seguimientos vencidos)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "daysInterval": 1, "triggerAtHour": 12 }] }
      },
      "id": "e2000000-0000-0000-0000-000000000001",
      "name": "Daily 12:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://rtvvamemdhbvmyxtxonb.supabase.co/rest/v1/rpc/n8n_list_overdue_followups",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "sb_publishable_5d6aTvUaYwT09DhI5AtRww_GZq2rZ0A" },
            { "name": "Authorization", "value": "Bearer sb_publishable_5d6aTvUaYwT09DhI5AtRww_GZq2rZ0A" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"p_limit\": 200\n}",
        "options": {}
      },
      "id": "e2000000-0000-0000-0000-000000000002",
      "name": "List Overdue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "rZvKjdRnF39vlXHi", "name": "CRM Lite Webhook Secret" }
      }
    },
    {
      "parameters": {
        "jsCode": "// La RPC devuelve un array de payloads normalizados ya listos para Notify User.\n// n8n divide el array en items; si vino vacío, cortamos acá.\nconst items = $input.all();\nif (items.length === 0) return [];\n// Si el array llegó como un solo item (según cómo PostgREST/n8n lo entreguen), lo aplanamos.\nconst flat = [];\nfor (const it of items) {\n  const j = it.json;\n  if (Array.isArray(j)) { for (const p of j) flat.push({ json: p }); }\n  else { flat.push({ json: j }); }\n}\nreturn flat;"
      },
      "id": "e2000000-0000-0000-0000-000000000003",
      "name": "To Payloads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": { "batchSize": 3, "options": {} },
      "id": "e2000000-0000-0000-0000-000000000004",
      "name": "Batch",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [720, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://n8n.moremigracion.com/webhook/crm-notify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "e2000000-0000-0000-0000-000000000005",
      "name": "Send to Notify User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "rZvKjdRnF39vlXHi", "name": "CRM Lite Webhook Secret" }
      }
    },
    {
      "parameters": { "amount": 1.5 },
      "id": "e2000000-0000-0000-0000-000000000006",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1200, 0],
      "webhookId": "e2000000-wait-notify-overdue"
    }
  ],
  "connections": {
    "Daily 12:00 UTC": { "main": [[{ "node": "List Overdue", "type": "main", "index": 0 }]] },
    "List Overdue": { "main": [[{ "node": "To Payloads", "type": "main", "index": 0 }]] },
    "To Payloads": { "main": [[{ "node": "Batch", "type": "main", "index": 0 }]] },
    "Batch": { "main": [[], [{ "node": "Send to Notify User", "type": "main", "index": 0 }]] },
    "Send to Notify User": { "main": [[{ "node": "Wait", "type": "main", "index": 0 }]] },
    "Wait": { "main": [[{ "node": "Batch", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
