{
  "name": "CRM Lite — GHL Inbound (webhook GHL → Supabase)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crm-ghl-inbound",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "e1000000-0000-0000-0000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "e1000000-0000-0000-0000-000000000001",
      "credentials": {
        "httpHeaderAuth": { "id": "rZvKjdRnF39vlXHi", "name": "CRM Lite Webhook Secret" }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.body ?? $input.first().json;\nconst contact = raw.contact ?? raw.data?.contact ?? raw;\nconst id = contact.id ?? contact.contact_id ?? contact.contactId;\nif (!id) throw new Error('inbound payload sin id de contacto');\nreturn [{ json: { contactId: id } }];"
      },
      "id": "e1000000-0000-0000-0000-000000000004",
      "name": "Extract ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://services.leadconnectorhq.com/contacts/{{ $json.contactId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Version", "value": "2021-07-28" }]
        },
        "options": {}
      },
      "id": "e1000000-0000-0000-0000-000000000005",
      "name": "GHL Get Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [380, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "gw0VVz43aChxVaFA", "name": "GHL LeadConnector (Authorization)" }
      }
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst contact = res.contact ?? res;\nif (!contact.id) throw new Error('GHL no devolvió el contacto');\nconst tags = Array.isArray(contact.tags) ? contact.tags : [];\nconst name = contact.contactName || [contact.firstName, contact.lastName].filter(Boolean).join(' ') || contact.name || 'Sin nombre';\nreturn [{\n  json: {\n    crm_contact_id: contact.id,\n    full_name: name,\n    email: contact.email ?? null,\n    phone: contact.phone ?? null,\n    company: contact.companyName ?? contact.company ?? null,\n    tags\n  }\n}];"
      },
      "id": "e1000000-0000-0000-0000-000000000002",
      "name": "Normalize GHL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://koyihquworbcxuydyslm.supabase.co/rest/v1/rpc/n8n_crm_upsert_inbound",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "sb_publishable_e_iEi26x16a5SjT_-17fhg_H6oFkQBn" },
            { "name": "Authorization", "value": "Bearer sb_publishable_e_iEi26x16a5SjT_-17fhg_H6oFkQBn" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_payload\": {{ JSON.stringify($json) }}\n}",
        "options": {}
      },
      "id": "e1000000-0000-0000-0000-000000000003",
      "name": "Upsert Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "rZvKjdRnF39vlXHi", "name": "CRM Lite Webhook Secret" }
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Extract ID", "type": "main", "index": 0 }]] },
    "Extract ID": { "main": [[{ "node": "GHL Get Contact", "type": "main", "index": 0 }]] },
    "GHL Get Contact": { "main": [[{ "node": "Normalize GHL", "type": "main", "index": 0 }]] },
    "Normalize GHL": { "main": [[{ "node": "Upsert Supabase", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
