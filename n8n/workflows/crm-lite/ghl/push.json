{
  "name": "CRM Lite — GHL Push (upsert de contacto)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crm-push",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "c3000000-0000-0000-0000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "c3000000-0000-0000-0000-000000000001",
      "credentials": {
        "httpHeaderAuth": { "id": "rZvKjdRnF39vlXHi", "name": "CRM Lite Webhook Secret" }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.body ?? $input.first().json;\nlet contact = raw.contact;\nif (!contact) {\n  contact = {\n    id: raw.id,\n    full_name: raw.name,\n    email: raw.email,\n    phone: raw.phone,\n    company: raw.company ?? raw.companyName,\n    status: raw.status ?? 'pending',\n    tags: raw.tags ?? []\n  };\n}\nconst tags = Array.isArray(contact.tags) ? contact.tags : [];\nconst crmLiteTags = tags.filter((t) => typeof t === 'string' && !t.startsWith('crm-lite:'));\nreturn [{\n  json: {\n    clientId: contact.id,\n    contact,\n    ghlBody: {\n      locationId: 'YF36RPtJ1lRQBqM7Qxgc',\n      name: contact.full_name,\n      email: contact.email,\n      phone: contact.phone,\n      companyName: contact.company,\n      tags: crmLiteTags\n    }\n  }\n}];"
      },
      "id": "c3000000-0000-0000-0000-000000000003",
      "name": "Map to GHL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/contacts/upsert",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Version", "value": "2021-07-28" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.ghlBody) }}",
        "options": {}
      },
      "id": "c3000000-0000-0000-0000-000000000002",
      "name": "GHL Upsert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "gw0VVz43aChxVaFA", "name": "GHL LeadConnector (Authorization)" }
      }
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst ghlContact = res.contact ?? res.data?.contact ?? res;\nconst ghlId = ghlContact.id ?? ghlContact.contactId;\nconst clientId = $('Map to GHL').first().json.clientId;\nif (!ghlId) throw new Error('GHL upsert did not return contact id');\nif (!clientId) throw new Error('Missing Supabase client id in payload');\nreturn [{ json: { clientId, ghlId, contact: $('Map to GHL').first().json.contact } }];"
      },
      "id": "c3000000-0000-0000-0000-000000000004",
      "name": "Extract GHL ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://rtvvamemdhbvmyxtxonb.supabase.co/rest/v1/rpc/n8n_crm_writeback",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "sb_publishable_5d6aTvUaYwT09DhI5AtRww_GZq2rZ0A" },
            { "name": "Authorization", "value": "Bearer sb_publishable_5d6aTvUaYwT09DhI5AtRww_GZq2rZ0A" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_client_id\": {{ JSON.stringify($json.clientId) }},\n  \"p_crm_contact_id\": {{ JSON.stringify($json.ghlId) }}\n}",
        "options": {}
      },
      "id": "c3000000-0000-0000-0000-000000000005",
      "name": "Supabase Writeback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "rZvKjdRnF39vlXHi", "name": "CRM Lite Webhook Secret" }
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Map to GHL", "type": "main", "index": 0 }]] },
    "Map to GHL": { "main": [[{ "node": "GHL Upsert", "type": "main", "index": 0 }]] },
    "GHL Upsert": { "main": [[{ "node": "Extract GHL ID", "type": "main", "index": 0 }]] },
    "Extract GHL ID": { "main": [[{ "node": "Supabase Writeback", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
