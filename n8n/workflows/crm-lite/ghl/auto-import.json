{
  "name": "CRM Lite — GHL Auto-import (cron por tag)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] }
      },
      "id": "f1000000-0000-0000-0000-000000000001",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://koyihquworbcxuydyslm.supabase.co/rest/v1/rpc/n8n_get_integration_settings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "sb_publishable_e_iEi26x16a5SjT_-17fhg_H6oFkQBn" },
            { "name": "Authorization", "value": "Bearer sb_publishable_e_iEi26x16a5SjT_-17fhg_H6oFkQBn" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {}
      },
      "id": "f1000000-0000-0000-0000-000000000002",
      "name": "Get Settings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "rZvKjdRnF39vlXHi", "name": "CRM Lite Webhook Secret" }
      }
    },
    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nif (!s.ghl_auto_import_enabled) return [];\nconst tags = Array.isArray(s.ghl_auto_import_tags) ? s.ghl_auto_import_tags : [];\nreturn tags.filter((t) => typeof t === 'string' && t.trim()).map((tag) => ({ json: { tag: tag.trim() } }));"
      },
      "id": "f1000000-0000-0000-0000-000000000003",
      "name": "Tags to Process",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/contacts/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Version", "value": "2021-07-28" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"locationId\": \"YF36RPtJ1lRQBqM7Qxgc\",\n  \"pageLimit\": 50,\n  \"filters\": [ { \"field\": \"tags\", \"operator\": \"contains\", \"value\": {{ JSON.stringify($json.tag) }} } ]\n}",
        "options": {}
      },
      "id": "f1000000-0000-0000-0000-000000000004",
      "name": "GHL Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "gw0VVz43aChxVaFA", "name": "GHL LeadConnector (Authorization)" }
      }
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst contacts = Array.isArray(res.contacts) ? res.contacts : [];\nreturn contacts.map((c) => {\n  const name = c.contactName || [c.firstName, c.lastName].filter(Boolean).join(' ') || c.email || c.phone || 'Sin nombre';\n  return {\n    json: {\n      crm_contact_id: c.id,\n      full_name: name,\n      email: c.email ?? null,\n      phone: c.phone ?? null,\n      company: c.companyName ?? null,\n      tags: Array.isArray(c.tags) ? c.tags : []\n    }\n  };\n});"
      },
      "id": "f1000000-0000-0000-0000-000000000005",
      "name": "Normalize Contacts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 0]
    },
    {
      "parameters": { "batchSize": 10, "options": {} },
      "id": "f1000000-0000-0000-0000-000000000006",
      "name": "Batch",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://koyihquworbcxuydyslm.supabase.co/rest/v1/rpc/n8n_crm_upsert_inbound",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "sb_publishable_e_iEi26x16a5SjT_-17fhg_H6oFkQBn" },
            { "name": "Authorization", "value": "Bearer sb_publishable_e_iEi26x16a5SjT_-17fhg_H6oFkQBn" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_payload\": {{ JSON.stringify($json) }}\n}",
        "options": {}
      },
      "id": "f1000000-0000-0000-0000-000000000007",
      "name": "Upsert Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "rZvKjdRnF39vlXHi", "name": "CRM Lite Webhook Secret" }
      }
    },
    {
      "parameters": { "amount": 0.4 },
      "id": "f1000000-0000-0000-0000-000000000008",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1680, 0],
      "webhookId": "f1000000-wait-auto"
    }
  ],
  "connections": {
    "Every hour": { "main": [[{ "node": "Get Settings", "type": "main", "index": 0 }]] },
    "Get Settings": { "main": [[{ "node": "Tags to Process", "type": "main", "index": 0 }]] },
    "Tags to Process": { "main": [[{ "node": "GHL Search", "type": "main", "index": 0 }]] },
    "GHL Search": { "main": [[{ "node": "Normalize Contacts", "type": "main", "index": 0 }]] },
    "Normalize Contacts": { "main": [[{ "node": "Batch", "type": "main", "index": 0 }]] },
    "Batch": { "main": [[{ "node": "Upsert Supabase", "type": "main", "index": 0 }]] },
    "Upsert Supabase": { "main": [[{ "node": "Wait", "type": "main", "index": 0 }]] },
    "Wait": { "main": [[{ "node": "Batch", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
