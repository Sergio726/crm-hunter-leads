# CRM Lite web — variables de entorno (copiar a .env.local para desarrollo)
# Ningún valor acá es secreto de verdad salvo N8N_WEBHOOK_SECRET.

# --- Tiempo de BUILD (se inyectan en el bundle; en Docker van como build args) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXX

# --- Solo RUNTIME (route handlers /api/ghl/*; en Docker van como env del contenedor) ---
# URL base de la instancia n8n (sin barra final)
N8N_BASE_URL=https://n8n.TU-DOMINIO.com
# Mismo valor que la credencial "CRM Lite Webhook Secret" en n8n
N8N_WEBHOOK_SECRET=CAMBIAME

# --- Prospección (route handlers /api/prospect/*) ---
# Google Cloud Console → habilitar "Places API (New)" → crear API key → restringirla
# a esa API. Sin esta key el módulo de prospección no puede buscar.
GOOGLE_PLACES_API_KEY=CAMBIAME
# Clave de la API de Claude, para el asistente que define el avatar.
# Es OPCIONAL: sin ella el chat degrada a un modo guiado sin IA y los filtros
# se cargan a mano. Se saca en console.anthropic.com.
ANTHROPIC_API_KEY=
