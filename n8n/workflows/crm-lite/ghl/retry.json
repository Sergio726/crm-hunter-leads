{
  "name": "CRM Lite — GHL Retry (pendientes de sync)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] }
      },
      "id": "d1000000-0000-0000-0000-000000000001",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://rtvvamemdhbvmyxtxonb.supabase.co/rest/v1/rpc/n8n_crm_list_pending",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "sb_publishable_5d6aTvUaYwT09DhI5AtRww_GZq2rZ0A" },
            { "name": "Authorization", "value": "Bearer sb_publishable_5d6aTvUaYwT09DhI5AtRww_GZq2rZ0A" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"p_limit\": 50\n}",
        "options": {}
      },
      "id": "d1000000-0000-0000-0000-000000000002",
      "name": "List Pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "rZvKjdRnF39vlXHi", "name": "CRM Lite Webhook Secret" }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json;\nconst list = Array.isArray(rows) ? rows : [];\nif (list.length === 0) return [];\nreturn list.map((c) => ({\n  json: {\n    event: 'contact.upserted',\n    contact: {\n      id: c.id,\n      full_name: c.full_name,\n      phone: c.phone,\n      email: c.email,\n      company: c.company,\n      status: c.status,\n      tags: c.tags ?? []\n    }\n  }\n}));"
      },
      "id": "d1000000-0000-0000-0000-000000000003",
      "name": "To Push Payloads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": { "batchSize": 5, "options": {} },
      "id": "d1000000-0000-0000-0000-000000000004",
      "name": "Batch",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [720, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://n8n.stlabs.ar/webhook/crm-push",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "d1000000-0000-0000-0000-000000000005",
      "name": "Re-Push",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "rZvKjdRnF39vlXHi", "name": "CRM Lite Webhook Secret" }
      }
    },
    {
      "parameters": { "amount": 0.3 },
      "id": "d1000000-0000-0000-0000-000000000006",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1200, 0],
      "webhookId": "d1000000-wait-retry"
    }
  ],
  "connections": {
    "Every 15 min": { "main": [[{ "node": "List Pending", "type": "main", "index": 0 }]] },
    "List Pending": { "main": [[{ "node": "To Push Payloads", "type": "main", "index": 0 }]] },
    "To Push Payloads": { "main": [[{ "node": "Batch", "type": "main", "index": 0 }]] },
    "Batch": { "main": [[{ "node": "Re-Push", "type": "main", "index": 0 }]] },
    "Re-Push": { "main": [[{ "node": "Wait", "type": "main", "index": 0 }]] },
    "Wait": { "main": [[{ "node": "Batch", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
